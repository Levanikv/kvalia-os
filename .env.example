# --- Supabase (projet kvalia-os, eu-west-3) ---
# Clé publique : OK côté client (RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=https://gspidvxtnmtgifnlgcsu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GYFhG5yEJyU5zE1pPIEXyg_43urNC8G

# Clé service role : UNIQUEMENT côté serveur (apps/agent, jobs). Jamais dans le navigateur, jamais commitée.
# → Supabase dashboard > Project settings > API keys
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent ---
ANTHROPIC_API_KEY=
# Secret partagé pour signer les webhooks entrants (raccourci iOS, Telegram, Alexa)
CAPTURE_WEBHOOK_SECRET=

# --- Intégrations (par phase) ---
# Phase 1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phase 2
RAPIDAPI_KEY=
# Phase 3
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
# Entreprise — Tiime, API interne en lecture seule (ADR 0010). Service agent uniquement, jamais côté web.
# Identifiants du compte apps.tiime.fr ; le compte a la double authentification (code SMS) :
# première connexion avec `pnpm --filter @kvalia/agent tiime:connexion`, ou outils connecter_tiime / valider_code_tiime.
TIIME_EMAIL=
TIIME_PASSWORD=
# Identifiant de la société (le nombre après /companies/ dans l'URL apps.tiime.fr)
TIIME_SOCIETE_ID=
# Optionnel : version de l'app web Tiime envoyée dans l'en-tête tiime-app-version (défaut dans core)
TIIME_APP_VERSION=
# Phase 4
TELEGRAM_BOT_TOKEN=
ALEXA_SKILL_ID=

# Agent MCP v0 (mono-utilisateur) : uuid de ton utilisateur Supabase Auth
KVALIA_USER_ID=
# Port du serveur MCP (défaut 8787)
PORT=8787
# Secret dans l'URL du serveur MCP (/mcp/<token>) tant qu'il n'y a pas d'OAuth. Générer : openssl rand -hex 24
MCP_TOKEN=
